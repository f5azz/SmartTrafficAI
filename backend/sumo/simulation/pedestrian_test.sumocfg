<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <input>

        <net-file value="../network/intersection_ped.net.xml"/>

        <route-files value="../routes/traffic.rou.xml,../routes/pedestrians.rou.xml"/>

    </input>

    <time>

        <begin value="0"/>

        <end value="600"/>

    </time>

    <processing>

        <time-to-teleport value="-1"/>

    </processing>

    <report>

        <verbose value="true"/>

        <duration-log.statistics value="true"/>

    </report>

</configuration>